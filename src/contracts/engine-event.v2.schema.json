{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ENOS-JASON/sound-generator/blob/main/src/contracts/engine-event.v2.schema.json",
  "title": "Event envelope v2 (shape only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "sequence",
    "simulationTick",
    "simulationTimeSeconds",
    "type",
    "sourceComponentId",
    "causationId",
    "correlationId",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "simulationTick": {
      "type": "integer",
      "minimum": 0
    },
    "simulationTimeSeconds": {
      "type": "number",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "sourceComponentId": {
      "$ref": "#/$defs/id"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "maxProperties": 256
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    }
  }
}
